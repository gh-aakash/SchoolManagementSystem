# Production Dockerfile for Next.js Frontend
FROM node:18-alpine AS runner
WORKDIR /app

# ENV NODE_ENV production (Removed as we are using dev server for flexibility)

# Install all dependencies (needed for Tailwind/PostCSS during runtime/dev)
COPY package*.json ./
RUN npm install

# Copy the rest of the code
COPY . .

# Build the Next.js application
EXPOSE 3000

CMD ["npm", "run", "dev"]
