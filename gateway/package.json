  "devDependencies": {
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.3",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.1"
  }
